#!/usr/bin/env python3
"""Parallel-session helper for this repo. Standard: .agents/SESSIONS.md. Stdlib only.

  session start <task> [--own PATH]... [--provider P] [--objective TEXT] [--here]
  session status [--json] [--here]
  session land [--title T] [--pr] [--no-merge] [--local] [--here]
  session finish [--task TASK] [--here]

Managed by org-design-tooling/repo-kit; overwritten on every kit update.
The repository is the one this script lives in (the parent of .agents/), not the one the shell happens
to be in (kit 17): a lane that ran one repo's script from another repo's folder used to cut its worktree
in the wrong repo, silently. From a shell in a different repository every command refuses in one line
naming both, exits 2 and changes nothing; --here says the shell's repository is the one meant. From a
shell in no repository the script's own repository is used. Inside the script's repository the shell's
own worktree is the one acted on, so the primary's copy of the script can drive any session worktree.
Each run reports one event to Witness when Witness is on the machine, fail-open (WS-DDR-150, kit 17).
`start` and `land` turn on the pre-push portability check for this clone (activate_prepush);
`land` runs the same check itself before it pushes.
Before it pushes, `land` also runs the repository's own pre-land commands, declared under `pre_land` in
.agents/repository-policy.json, on the rebased tree; one that fails stops the land (kit 18).
`land` lands locally by default (squash onto origin/<base>, fast-forward push, no GitHub run);
it opens a PR only for ask paths, a base branch whose ruleset or protection requires a PR or
status checks, or `--pr` (WS-DDR-143 amendment 2026-09-24).
After a landing the session branch follows its squash, and a later `land` from the same worktree
skips any commits that already landed, so it never replays them onto their own squash (kit 12).
A file the branch untracks (`git rm --cached`) stays on disk through land's rebase: it is copied
into the worktree's git dir first and put back after, and `finish` waits while a copy is left (kit 13).
A read of a worktree, above all another session's, runs with GIT_OPTIONAL_LOCKS=0 (READ_ONLY): a plain
`git status` takes the worktree's index.lock while it walks it, and the other session's `git add` in that
moment fails (kit 20).
`start` refuses to cut a worktree that would leave the disk under SESSION_MIN_FREE_GB (10) free, and warns under
SESSION_WARN_FREE_GB (25); SESSION_ALLOW_LOW_DISK=1 starts anyway, once. Fail-open on any measuring error (kit 21).
`land` measures content changes against KF-11 (over 25 files per session or per agent per day lands only as a
reviewed diff): advisory, with a review summary in the handoff; SESSION_KF11_ENFORCE=1 makes it a refusal (kit 23).
"""
import argparse, contextlib, datetime as dt, filecmp, fnmatch, importlib.util, io, json, os, re, shutil, signal, subprocess, sys, time
from pathlib import Path

SLUG = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$")
FOOTER = "\n\n\U0001F916 Generated with [Claude Code](https://claude.com/claude-code)"
WRONG_REPO = 2  # exit status of a refusal: the shell is standing in a repository this script does not belong to


def _kit_dir():
    """The checkout this script is installed in: <checkout>/.agents/bin/session. None for a copy anywhere else."""
    p = Path(__file__).resolve()
    return p.parents[2] if p.parent.name == "bin" and p.parent.parent.name == ".agents" and len(p.parts) > 3 else None


KIT_DIR = _kit_dir()


def _kit_version():
    try:
        return (KIT_DIR / ".agents" / "KIT_VERSION").read_text().strip()
    except Exception:
        return "unknown"


KIT_VERSION = _kit_version()  # read once: `finish` removes the worktree this script lives in before the event is sent


def run(args, cwd, check=True, env=None):
    """env: variables added to this process's environment for this one call (READ_ONLY for a read)."""
    r = subprocess.run(args, cwd=cwd, text=True, capture_output=True, env={**os.environ, **env} if env else None)
    if check and r.returncode:
        sys.exit(f"session: `{' '.join(args)}` failed in {cwd}:\n{r.stderr.strip() or r.stdout.strip()}")
    return r


def git(cwd, *a, check=True, env=None):
    return run(["git", *a], cwd, check, env).stdout.strip()


# Every git read of a worktree that may be another session's runs with this (kit 20). A plain `git status`
# refreshes the index as a side effect: it takes the worktree's index.lock and holds it for its whole walk
# of the worktree, so the owning session's `git add` in that moment fails ("index.lock: File exists").
# With GIT_OPTIONAL_LOCKS=0 git skips that optional refresh and takes no lock; what it reports is the same.
# Cast, 2026-09-30: an archetype land's unchecked `git add` failed on its lock while other lanes ran
# `session status` and `session start`, and it committed half of its files (AR-04, AR-05).
READ_ONLY = {"GIT_OPTIONAL_LOCKS": "0"}


def commit(cwd, provider, *a):
    """Commit with AGENT_NAME set, for repos whose pre-commit checks handoff ownership."""
    env = dict(os.environ, AGENT_NAME=os.environ.get("AGENT_NAME") or provider)
    r = subprocess.run(["git", "commit", *a], cwd=cwd, text=True, capture_output=True, env=env)
    if r.returncode:
        sys.exit(f"session: commit failed in {cwd}:\n{(r.stderr or r.stdout).strip()}")


def repo_of(path):
    """(top, primary, common) of the git work tree that holds `path`, or None when it is in none.

    top is that work tree's root, primary the repository's own checkout (the parent of the common git
    dir, the same for every worktree of it), common the common git dir with symlinks resolved: two
    paths are one repository exactly when their common dirs are equal."""
    if path is None:
        return None
    r = run(["git", "rev-parse", "--show-toplevel", "--path-format=absolute", "--git-common-dir"], path, check=False)
    lines = r.stdout.splitlines()
    if r.returncode or len(lines) < 2 or not lines[0].strip() or not lines[1].strip():
        return None
    common = Path(lines[1].strip())
    return Path(lines[0].strip()), common.parent, common.resolve()


# What this run reports to Witness (WS-DDR-150): the repo it acted on, counts and a reason, never content.
EVENT = {"verb": None, "target": None, "confidential": False, "attrs": {}}


def acted_on(primary):
    EVENT["target"] = primary.name
    EVENT["confidential"] = "Work" in primary.parts  # engagement repos: events carry the client-confidential tag


def here(allow_other=False):
    """(top, primary, linked): the checkout this command acts on, the repository's primary checkout, and
    whether top is a linked worktree.

    The repository is the one this script lives in (the parent of .agents/), never merely the one the shell
    happens to be standing in: on 2026-09-28 two lanes ran Cast's script from the Workspaces root, and each
    cut its worktree and branch in the governance repo without a word. Inside the script's own repository
    the shell's worktree is the one acted on, so the primary's copy of the script can drive a session
    worktree (Cortege does) and the reverse. A shell in a different repository is refused, in one line naming
    both, exit status 2, nothing touched; allow_other (--here) says the shell's repository is the one meant.
    A shell in no repository, or in a directory since removed, falls back to the script's own checkout."""
    own = repo_of(KIT_DIR)
    try:
        cwd = repo_of(Path.cwd())
    except OSError:  # the shell's directory is gone (finish removes the worktree it stood in)
        cwd = None
    if own and cwd and own[2] != cwd[2] and not allow_other:
        acted_on(own[1])
        EVENT["attrs"].update(reason="wrong_repo", shell_repo=cwd[1].name)
        print(f"session: this script belongs to the repository at {own[0]}, but the shell is in {cwd[0]}, a different "
              f"repository; run it from {own[0]} (a subshell leaves this shell where it is: (cd {own[0]} && python3 "
              f".agents/bin/session {EVENT.get('verb') or '<command>'} ...)), or pass --here to act on the repository the shell is in",
              file=sys.stderr)
        sys.exit(WRONG_REPO)
    found = cwd or own
    if not found:
        sys.exit("session: not inside a git repository")
    top, primary, _ = found
    acted_on(primary)
    return top, primary, top.resolve() != primary.resolve()


def witness_emit():
    """Witness's shared emit call, found the way org-design-tooling/src/witness_bridge.py finds it:
    $WITNESS_ROOT/src, the Core/ folder above this file, then ~/Workspaces/Core. None when Witness is not here."""
    roots = []
    if os.environ.get("WITNESS_ROOT"):
        roots.append(Path(os.environ["WITNESS_ROOT"]) / "src")
    for parent in Path(__file__).resolve().parents:
        if parent.name == "Core":
            roots.append(parent / "products" / "witness" / "src")
            break
    roots.append(Path.home() / "Workspaces" / "Core" / "products" / "witness" / "src")
    for src in roots:
        if (src / "emit.py").is_file():
            spec = importlib.util.spec_from_file_location("witness_shared_emit", src / "emit.py")
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod.emit
    return None


def witness_report(cmd, code, started):
    """One event per run to Witness (WS-DDR-150): the verb, the repo, counts, a duration, never content.

    Fail-open by construction: Witness missing, a broken emit or a full disk leaves this command's output
    and exit status exactly as they were. Under pytest with no explicit WITNESS_INBOX nothing is written,
    so a test run never posts to the real inbox."""
    try:
        if os.environ.get("PYTEST_CURRENT_TEST") and not os.environ.get("WITNESS_INBOX"):
            return
        emit = witness_emit()
        if emit is None:
            return
        if code in (0, None):
            outcome = "ok"
        elif code == 3 or EVENT["attrs"].get("reason") in ("wrong_repo", "low_disk", "kf11"):
            outcome = "blocked"  # stopped for a person: a rebase conflict, a shell in the wrong repo, a full disk, KF-11
        elif cmd == "status" and code == 1:
            outcome = "ok"  # overlaps found: a finding, not a failure
        else:
            outcome = "error"
        extra = {"redaction_level": "client-confidential"} if EVENT["confidential"] else {}
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            emit("org-design-tooling", "org_design_tooling.session_kit", outcome=outcome,
                 duration_ms=(time.monotonic() - started) * 1000.0, target=EVENT["target"],
                 verb=cmd, kit_version=KIT_VERSION, **EVENT["attrs"], **extra)
    except (Exception, SystemExit):  # an emit that calls sys.exit must not end this command either
        pass


def default_branch(repo):
    r = run(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], repo, check=False)
    return r.stdout.strip().split("/", 1)[1] if r.returncode == 0 and "/" in r.stdout else "main"


def gh_repo(root):
    """owner/name of origin, so gh never guesses between origin and an upstream remote."""
    url = git(root, "remote", "get-url", "origin", check=False)
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", url)
    return ["-R", m.group(1)] if m else []


def policy(root):
    p = root / ".agents" / "repository-policy.json"
    try:
        return json.loads(p.read_text())
    except Exception:
        return {}


def task_files(root):
    d = root / ".agents" / "tasks"
    return sorted(d.glob("*.json")) if d.is_dir() else []


def my_task(root, base_ref):
    """This session's task file: the record whose "branch" names the branch checked out here, among the records this
    branch added, changed (a task name reused the same day: start rewrites the record base already holds) or has not
    committed yet. Kit 25: until then the first added record won, so a branch that also added an older record (a
    rename) closed that one and landed its own still live (governance root, 2026-10-02 and 2026-10-03). With no
    record naming the branch, the first added or untracked one, as before."""
    def names(*a):
        return [r for r in git(root, *a, "--", ".agents/tasks/", check=False, env=READ_ONLY).split() if r.endswith(".json")]
    added = names("diff", "--name-only", "--diff-filter=A", f"{base_ref}...HEAD")
    changed = names("diff", "--name-only", "--diff-filter=M", f"{base_ref}...HEAD") + names("diff", "--name-only", "HEAD")
    untracked = names("ls-files", "--others", "--exclude-standard")
    branch = git(root, "branch", "--show-current", check=False, env=READ_ONLY)
    if branch:
        for rel in dict.fromkeys(added + untracked + changed):
            try:
                if json.loads((root / rel).read_text()).get("branch") == branch:
                    return root / rel
            except (OSError, ValueError):
                continue
    for rel in added + untracked:
        return root / rel
    return None


def primary_behind(primary, base):
    """How many commits origin/<base> has that the primary's HEAD lacks (no fetch here)."""
    n = git(primary, "rev-list", "--count", f"HEAD..origin/{base}", check=False)
    return int(n) if n.isdigit() else 0


def ff_primary(primary, base):
    """Fast-forward the primary checkout to origin/<base>: the one place the kit ever moves it.

    Never force, never reset, never stash, never touch a primary that is not on its base branch:
    a parked branch, a detached HEAD or a colliding local edit all leave it alone and say so.
    Returns True when the primary now equals origin/<base>."""
    run(["git", "fetch", "-q", "origin", base], primary, check=False)
    on = git(primary, "branch", "--show-current", check=False)
    if on != base:
        print(f"primary NOT fast-forwarded: it is on {on or '(detached)'}, not {base}; it lags origin/{base} by "
              f"{primary_behind(primary, base)} until {base} is checked out and `session finish` runs")
        return False
    if primary_behind(primary, base) == 0:
        print(f"primary already at origin/{base} ({git(primary, 'rev-parse', '--short', 'HEAD', check=False)})")
        return True
    r = run(["git", "merge", "--ff-only", "-q", f"origin/{base}"], primary, check=False)
    if r.returncode:
        reason = " ".join((r.stderr or r.stdout).strip().split())[:200]
        print(f"primary NOT fast-forwarded: {reason}")
        return False
    print(f"primary fast-forwarded to {git(primary, 'rev-parse', '--short', 'HEAD', check=False)}")
    return True


HOOK_NAME = "session-kit-portability"
HOOK_CMD = "test ! -f .agents/hooks/pre-push || sh .agents/hooks/pre-push"
SHIM_MARK = "# session-kit pre-push shim"


def activate_prepush(repo):
    """Turn on .agents/hooks/pre-push for this clone without displacing any existing hook.

    Git 2.54+ config hooks run beside the hook directory's own pre-push (Entire, a repo's
    .githooks), so this only adds. On an older git, a .git/hooks/pre-push shim is written only
    when core.hooksPath is unset and no pre-push hook exists. Same logic as repo-kit/install.py."""
    have = git(repo, "config", "--get", f"hook.{HOOK_NAME}.command", check=False)
    if have != HOOK_CMD:
        git(repo, "config", f"hook.{HOOK_NAME}.event", "pre-push", check=False)
        git(repo, "config", f"hook.{HOOK_NAME}.command", HOOK_CMD, check=False)
    listed = run(["git", "hook", "list", "pre-push"], repo, check=False)
    if listed.returncode == 0 and HOOK_NAME in listed.stdout:
        return
    if git(repo, "config", "--get", "core.hooksPath", check=False):
        print("note: pre-push portability check not activated (core.hooksPath is set and this git has no "
              "config hooks); `session land` still runs it")
        return
    shim = Path(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "hooks" / "pre-push"
    if shim.exists():
        if SHIM_MARK not in shim.read_text(errors="replace"):
            print("note: pre-push portability check not activated (a pre-push hook exists and this git has no "
                  "config hooks); `session land` still runs it")
        return
    shim.parent.mkdir(parents=True, exist_ok=True)
    shim.write_text(f"#!/bin/sh\n{SHIM_MARK} (org-design-tooling/repo-kit)\n{HOOK_CMD} \"$@\"\n")
    shim.chmod(0o755)


PRE_LAND_TIMEOUT = 300       # seconds, for an entry that names none
PRE_LAND_TIMEOUT_MAX = 1800  # a land is not a place for a long suite
PRE_LAND_TAIL = 40           # lines of a command's output the land shows


def pre_land_commands(top):
    """The repository's own pre-land commands (kit 18): the list under "pre_land" in the worktree's
    .agents/repository-policy.json, each {"name": str, "run": [argument, ...], "timeout_s": seconds}.
    `{python}` in run is the interpreter running this script; a relative path is relative to the worktree.
    Returns [(name, argv, timeout)], [] when none are declared.

    Fails closed, exit status 1: a policy file that does not parse, or an entry without a name, a non-empty
    list of string arguments and a timeout between 1 and PRE_LAND_TIMEOUT_MAX seconds, stops the land. It is
    read here and not through policy(), which reads an unreadable file as no policy: for a gate, that would
    turn the gate off without a word (Cast pipeline gap closure, AUD-30, 2026-09-30)."""
    p = top / ".agents" / "repository-policy.json"
    if not p.is_file():
        return []
    try:
        pol = json.loads(p.read_text())
    except ValueError as e:
        EVENT["attrs"]["reason"] = "pre_land"
        sys.exit(f"session: .agents/repository-policy.json does not parse ({e}), so its pre_land gate cannot be "
                 "read; fix the file and land again")
    raw = pol.get("pre_land", []) if isinstance(pol, dict) else None
    if not isinstance(raw, list):
        EVENT["attrs"]["reason"] = "pre_land"
        sys.exit("session: pre_land in .agents/repository-policy.json must be a list of commands; fix it and land again")
    out = []
    for i, e in enumerate(raw):
        e = e if isinstance(e, dict) else {}
        name, argv, limit = e.get("name"), e.get("run"), e.get("timeout_s", PRE_LAND_TIMEOUT)
        ok = (isinstance(name, str) and name.strip() and isinstance(argv, list) and argv
              and all(isinstance(x, str) and x for x in argv)
              and isinstance(limit, (int, float)) and not isinstance(limit, bool) and 1 <= limit <= PRE_LAND_TIMEOUT_MAX)
        if not ok:
            label = name.strip() if isinstance(name, str) and name.strip() else f"entry {i + 1}"
            EVENT["attrs"].update(reason="pre_land", pre_land=label[:80])
            sys.exit(f"session: pre_land {label!r} in .agents/repository-policy.json needs a name, a non-empty \"run\" "
                     f"list of arguments and a timeout_s from 1 to {PRE_LAND_TIMEOUT_MAX} seconds; fix the declaration "
                     "and land again")
        out.append((name.strip(), [sys.executable if x == "{python}" else x for x in argv], float(limit)))
    return out


def run_pre_land(top, commands):
    """Run each pre-land command in the worktree, in order, and stop the land (exit status 1, never 3, which
    callers read as a rebase conflict) at the first that exits non-zero or outlives its timeout. The last
    PRE_LAND_TAIL lines of its output are shown whichever way it ends. A command that times out is killed
    with its whole process group, so a test runner's children do not outlive the land."""
    for name, argv, limit in commands:
        started = time.monotonic()
        try:
            proc = subprocess.Popen(argv, cwd=top, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    env=dict(os.environ, SESSION_PRE_LAND=name), start_new_session=True)
        except OSError as e:
            EVENT["attrs"].update(reason="pre_land", pre_land=name[:80])
            sys.exit(f"session: pre-land check {name!r} failed (it could not start: {e}); fix it and land again")
        try:
            output, _ = proc.communicate(timeout=limit)
            why = f"exit {proc.returncode}"
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                proc.kill()
            output, _ = proc.communicate()
            why = f"timed out after {limit:g} s"
        lines = (output or "").strip().splitlines()
        if lines:
            print(f"pre-land check {name!r}:" + ("" if len(lines) <= PRE_LAND_TAIL else f" (last {PRE_LAND_TAIL} lines)"))
            print("\n".join("  " + x for x in lines[-PRE_LAND_TAIL:]))
        if why == "exit 0":
            print(f"pre-land check {name!r} passed ({time.monotonic() - started:.1f} s)")
            EVENT["attrs"]["pre_land_passed"] = EVENT["attrs"].get("pre_land_passed", 0) + 1
            continue
        EVENT["attrs"].update(reason="pre_land", pre_land=name[:80])
        sys.exit(f"session: pre-land check {name!r} failed ({why}); fix it and land again (the repository's own "
                 "gate, declared under pre_land in .agents/repository-policy.json)")


def portability_check(top):
    """The pre-push check, run by land before it pushes. Returns True when it passes or is absent."""
    chk = top / ".agents" / "bin" / "portability-check"
    if not chk.is_file():
        return True
    r = run([sys.executable, str(chk)], top, check=False)
    out = (r.stdout + r.stderr).strip()
    if out:
        print(out)
    if r.returncode == 0:
        # the pre-push hook sees this and skips re-running the check on the same commit
        os.environ["SESSION_PORTABILITY_CHECKED"] = git(top, "rev-parse", "HEAD")
    return r.returncode == 0


def follow(top, landed, head, base):
    """Point the session branch at the commit that landed it. Only when the trees match, so the
    working tree and index stay as they are; compare-and-swap on the old head, never a reset."""
    if git(top, "rev-parse", "-q", "--verify", f"{landed}^{{tree}}", check=False) != git(top, "rev-parse", f"{head}^{{tree}}"):
        return False
    r = run(["git", "update-ref", "-m", f"session land: follow the landing on origin/{base}", "HEAD", landed, head], top, check=False)
    if r.returncode == 0:
        print(f"branch now at {landed[:8]}: a later land from this worktree replays only new commits")
    return r.returncode == 0


def has_gh():
    return shutil.which("gh") is not None


def landed_boundary(top, base, branch, up=None):
    """Where an earlier landing from this branch ends: (newest landed commit of ours, rebase target,
    why) or None. Kit 11 and earlier left the branch on its unsquashed commits after a landing, and
    an auto-merged PR still does; rebasing those onto origin/<base> replays them onto their own
    squash, and batches that touched the same lines conflict with themselves.

    A local landing's squash has the tree of the branch head it landed, so a commit on origin/<base>
    with the same tree as one of ours marks it. A PR that GitHub squashed after origin/<base> moved
    has a tree of its own; for a branch that was pushed for a PR, GitHub says which head it merged."""
    up = up or f"origin/{base}"
    mine = [l.split() for l in git(top, "log", "--format=%H %T", f"{up}..HEAD", check=False).splitlines()]
    if not mine:
        return None
    landed = {}
    for h, t in (l.split() for l in git(top, "log", "--reverse", "--format=%H %T", f"HEAD..{up}", check=False).splitlines()):
        landed.setdefault(t, h)
    for h, t in mine:  # newest first
        if t in landed:
            return h, landed[t], f"its tree is {landed[t][:8]} on origin/{base}"
    if branch and has_gh() and git(top, "config", "--get", f"branch.{branch}.merge", check=False):
        r = run(["gh", "pr", "list", *gh_repo(top), "--head", branch, "--state", "merged",
                 "--json", "number,headRefOid", "--limit", "50"], top, check=False)
        try:
            heads = {x["headRefOid"]: x["number"] for x in json.loads(r.stdout or "[]")} if r.returncode == 0 else {}
        except (ValueError, KeyError, TypeError):
            heads = {}
        for h, _ in mine:
            if h in heads:
                return h, up, f"PR #{heads[h]} merged it"
    return None


def kept_dir(top):
    """Where land keeps a copy of each file the branch untracks while a rebase runs: this worktree's
    own git dir, which no checkout, rebase or clean reaches. `git worktree remove` deletes it with
    the worktree, so finish refuses while anything is left in it."""
    return Path(git(top, "rev-parse", "--path-format=absolute", "--git-dir")) / "session-kept"


def names(paths, n=8):
    return ", ".join(paths[:n]) + (f" and {len(paths) - n} more" if len(paths) > n else "")


def tree_paths(top, ref):
    return set(run(["git", "ls-tree", "-r", "-z", "--name-only", ref], top, check=False).stdout.split("\0")) - {""}


def keep_untracked(top, base, onto=None, up=None):
    """Copy aside each file this branch untracks (`git rm --cached`) that is still on disk and that
    the rebase target still tracks. The rebase checks the target out first, git overwrites an
    ignored file there without asking, and replaying the untrack commit then deletes it: the loss
    `git rm --cached` promises never happens (an engagement repo, 2026-09-24). Returns the paths kept."""
    up = up or f"origin/{base}"
    mb = git(top, "merge-base", "HEAD", up, check=False)
    if not mb:
        return []
    gone = run(["git", "diff", "--name-only", "-z", "--no-renames", "--diff-filter=D", mb, "HEAD"], top, check=False).stdout
    on_disk = [p for p in gone.split("\0") if p and ((top / p).is_symlink() or (top / p).is_file())]
    if not on_disk:
        return []
    tracked = set().union(*(tree_paths(top, ref) for ref in {up, onto or up}))
    kept = [p for p in on_disk if p in tracked]
    kd = kept_dir(top)
    clash = [p for p in kept if os.path.lexists(kd / p)]
    if clash:
        sys.exit(f"session: an earlier land still keeps a copy of {names(clash)} in {kd}, and this rebase would replace "
                 "the file again. Merge the kept copy with the one in the worktree by hand, delete the kept copy, then land again")
    for p in kept:
        (kd / p).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(top / p, kd / p, follow_symlinks=False)
    return kept


def same(a, b):
    if a.is_symlink() or b.is_symlink():
        return a.is_symlink() and b.is_symlink() and os.readlink(a) == os.readlink(b)
    return b.is_file() and filecmp.cmp(a, b, shallow=False)


def restore_untracked(top):
    """Put back what keep_untracked copied aside, only where nothing is lost: the path is untracked at
    HEAD and holds nothing, or holds the same thing. Returns (restored, [(path, why) still kept]),
    why being "tracked" (HEAD tracks the path) or "differs" (something wrote it after the rebase)."""
    kd = kept_dir(top)
    if not kd.is_dir():
        return [], []
    saved = []
    for d, dirs, files in os.walk(kd):
        saved += [Path(d) / x for x in files + [x for x in dirs if (Path(d) / x).is_symlink()]]
    head = tree_paths(top, "HEAD") if saved else set()
    restored, left = [], []
    for src in sorted(saved):
        rel = src.relative_to(kd).as_posix()
        dst = top / rel
        if rel in head:
            left.append((rel, "tracked"))
        elif not os.path.lexists(dst):
            dst.parent.mkdir(parents=True, exist_ok=True)
            try:
                os.replace(src, dst)
            except OSError:  # another filesystem
                shutil.copy2(src, dst, follow_symlinks=False)
                os.unlink(src)
            restored.append(rel)
        elif same(src, dst):
            os.unlink(src)
            restored.append(rel)
        else:
            left.append((rel, "differs"))
    for d, _, _ in sorted(os.walk(kd), reverse=True):  # deepest first: drop the folders emptied
        if not os.listdir(d):
            os.rmdir(d)
    return restored, left


def put_back(top, kept=(), stopped=False):
    """Restore the kept copies and say what happened. Returns the paths still kept."""
    restored, left = restore_untracked(top)
    kd = kept_dir(top) if left else None
    now = [p for p in kept if p in restored]
    if now:
        print(f"kept {len(now)} file(s) this branch untracks through the rebase: {names(now)}")
    earlier = [p for p in restored if p not in kept]
    if earlier:
        print(f"restored {names(earlier)}: an earlier land kept it aside during its rebase")
    for rel, why in left:
        if why == "tracked" and stopped:
            print(f"kept aside until the rebase finishes: {rel} (copy at {kd / rel}); the next `session land` puts it back")
        elif why == "tracked":
            print(f"NOT restored: {rel} is tracked at HEAD again; the copy land kept is at {kd / rel}")
        else:
            print(f"NOT restored: {rel} was written again after the rebase, and neither copy is the kit's to discard; "
                  f"the copy land kept is at {kd / rel}")
    if left and not stopped:
        print(f"Merge each by hand, then delete the kept copy; `session finish` waits until {kd} is empty.")
    return [rel for rel, _ in left]


def rebase_on_base(top, base, branch):
    """Rebase the session branch onto origin/<base>, first skipping commits that already landed.
    Returns the commit it rebased onto (a sha, truthy), or reports the conflict and returns "" (the
    rebase stays open to resolve). Files the branch untracks are kept through it (keep_untracked); a
    rebase with nothing to do touches no file, so they are copied only when origin/<base> moved or
    commits are skipped.

    Kit 19: origin/<base> is read ONCE, here, and the rebase goes onto that commit. Every worktree of a
    repository shares refs/remotes/origin/<base>, and a sibling session's `git push` moves it; the land
    must build its squash on the commit this branch was rebased onto, never on whatever the shared ref
    names later (Cast e2bcc5811 and 466d01305, 2026-09-30, reverted two sessions' landings that way)."""
    skipped = ""
    pin = git(top, "rev-parse", "--verify", f"origin/{base}^{{commit}}")
    b = landed_boundary(top, base, branch, up=pin)
    moving = b or run(["git", "merge-base", "--is-ancestor", pin, "HEAD"], top, check=False).returncode
    kept = keep_untracked(top, base, b[1] if b else None, up=pin) if moving else []
    if b:
        c, onto, why = b
        n = git(top, "rev-list", "--count", f"{pin}..{c}")
        rest = git(top, "rev-list", "--count", f"{c}..HEAD")
        skipped = f"{n} commit(s) on this branch already landed ({why})"
        print(f"{skipped}; replaying only the {rest} after them")
        r = run(["git", "rebase", "--onto", onto, c], top, check=False)
    if not b or r.returncode == 0:
        mb = git(top, "merge-base", "HEAD", pin, check=False)
        r = run(["git", "rebase", pin], top, check=False)
        if r.returncode == 0:
            put_back(top, kept)
            return pin
    else:
        mb = ""
    files = git(top, "diff", "--name-only", "--diff-filter=U", check=False)
    print("REBASE CONFLICT. Another session landed changes to the same lines:\n" + files)
    if skipped:
        print(f"(Not a replay of this branch's own landing: {skipped} and were skipped first.)")
    elif mb and branch:
        mine = git(top, "log", "--format=%h", "-F", f"--grep={branch}", f"{mb}..origin/{base}", check=False).split()
        if mine:
            print(f"Check first: {', '.join(mine)} on origin/{base} names this branch. If that is this branch's own "
                  f"earlier landing, `git rebase --abort`, then `git rebase --onto origin/{base} <the last commit "
                  "of yours it carries>`, and land again.")
    print("\nResolve by meaning: keep both sessions' intents, never drop theirs to make yours apply.\n"
          "Then `git add <files>`, `git rebase --continue`, and run `python3 .agents/bin/session land` again.")
    put_back(top, kept, stopped=True)
    return ""


def pushed(top, rev="HEAD"):
    """True when rev is already on some remote-tracking branch (never amend a pushed commit)."""
    return bool(git(top, "branch", "-r", "--contains", rev, check=False))


# Free-disk guard on `start` (kit 21). On 2026-10-02 Aurelius fell to 2 GB free: about 105 session worktrees
# had piled up across the repos (0.65 to 3.5 GB each, 3.4 GB for the largest engagement repo) and nothing said a
# word when the next one was cut. `start` now measures the disk that will hold the new worktree, estimates the
# checkout from the base tree's blob sizes (never a walk of the primary), refuses under a floor and warns under
# a softer line. Fail-open: a measurement that errors prints one note and the start goes on.
GB = 1024 ** 3
MIN_FREE_GB, WARN_FREE_GB = 10.0, 25.0  # SESSION_MIN_FREE_GB, SESSION_WARN_FREE_GB override; SESSION_ALLOW_LOW_DISK=1 overrides once


def _env_gb(name, default):
    v = os.environ.get(name, "").strip()
    return float(v) if v else default


def checkout_estimate(repo, ref):
    """Bytes a checkout of `ref` writes: the sum of its blob sizes from `git ls-tree -r -l -z`, read as bytes so
    no file name can fail to decode. A gitlink (a submodule, size "-") is skipped; so is any other entry git
    gives no size. An LFS file counts as its pointer, so this can read low for an LFS repository."""
    r = subprocess.run(["git", "ls-tree", "-r", "-l", "-z", ref], cwd=repo, capture_output=True,
                       env={**os.environ, **READ_ONLY})
    if r.returncode:
        raise RuntimeError(f"git ls-tree exited {r.returncode}")
    total = 0
    for entry in r.stdout.split(b"\0"):
        meta = entry.partition(b"\t")[0].split()
        if len(meta) == 4 and meta[1] == b"blob" and meta[3] != b"-":
            total += int(meta[3])
    return total


def linked_worktrees(primary):
    """How many linked worktrees the repository has (every entry of `git worktree list` but the primary)."""
    out = git(primary, "worktree", "list", "--porcelain", env=READ_ONLY)
    return max(0, sum(1 for line in out.splitlines() if line.startswith("worktree ")) - 1)


def disk_guard(primary, where, ref, adopt):
    """Refuse (exit, nothing created), warn, or pass before `start` cuts a worktree at `where` from `ref`.

    adopt (`--here`): nothing new is checked out, so it only ever warns. The Witness event gets the numbers
    (free_gb, estimate_gb) and the result (disk_guard: guard_ok, guard_warn, guard_refused, guard_overridden,
    or guard_skipped when the measurement failed), never a path. The key is disk_guard, not outcome: the
    event's own outcome field is witness_report's, and a second one would make the emit call raise."""
    try:
        floor = _env_gb("SESSION_MIN_FREE_GB", MIN_FREE_GB)
        soft = _env_gb("SESSION_WARN_FREE_GB", WARN_FREE_GB)
        free = shutil.disk_usage(where).free
        estimate = 0 if adopt else checkout_estimate(primary, ref)
    except Exception as e:  # fail-open: the guard never stops a start it could not measure
        EVENT["attrs"]["disk_guard"] = "guard_skipped"
        print(f"session: note: free-disk check skipped ({type(e).__name__}: {e}); starting without it", file=sys.stderr)
        return
    after = (free - estimate) / GB
    EVENT["attrs"].update(free_gb=round(free / GB, 2), estimate_gb=round(estimate / GB, 2))
    if after >= soft and (adopt or after >= floor):
        EVENT["attrs"]["disk_guard"] = "guard_ok"
        return
    try:
        n = linked_worktrees(primary)
    except BaseException:  # the count only decorates the message
        n = "an unknown number of"
    numbers = (f"{free / GB:.1f} GB free on this disk (adopting this worktree checks out nothing new)" if adopt else
               f"{free / GB:.1f} GB free on the disk that would hold it, the checkout needs about "
               f"{estimate / GB:.2f} GB, leaving {after:.1f} GB")
    remedy = (f"This repository has {n} linked worktree(s). See them with `python3 .agents/bin/session status`, "
              f"and run `python3 .agents/bin/session finish` in each one that has landed. The hourly worktree "
              f"reaper (com.brien.worktree-reaper) retires landed, idle worktrees on its own.")
    if not adopt and after < floor:
        if os.environ.get("SESSION_ALLOW_LOW_DISK", "").strip() == "1":
            EVENT["attrs"]["disk_guard"] = "guard_overridden"
            print(f"session: WARNING: LOW DISK, starting anyway because SESSION_ALLOW_LOW_DISK=1: {numbers}, "
                  f"under the {floor:g} GB floor (SESSION_MIN_FREE_GB). {remedy}", file=sys.stderr)
            return
        EVENT["attrs"].update(disk_guard="guard_refused", reason="low_disk")
        sys.exit(f"session: refusing to cut a new worktree, nothing was created: {numbers}, under the {floor:g} GB "
                 f"floor (SESSION_MIN_FREE_GB).\n{remedy}\nTo start anyway, once: "
                 f"SESSION_ALLOW_LOW_DISK=1 python3 .agents/bin/session start <task> ...")
    EVENT["attrs"]["disk_guard"] = "guard_warn"
    print(f"session: WARNING: LOW DISK: {numbers}, under the {soft:g} GB warning line (SESSION_WARN_FREE_GB). "
          f"{remedy}", file=sys.stderr)


def cmd_start(a):
    top, primary, linked = here(a.here)
    EVENT["attrs"].update(adopt=bool(a.here), linked=linked)
    if not SLUG.match(a.task):
        sys.exit("session: task must be a short slug of letters, digits, dot, dash, underscore")
    today = dt.date.today().isoformat()
    provider = a.provider or os.environ.get("SESSION_PROVIDER") or "claude"
    base = default_branch(primary)
    git(primary, "fetch", "-q", "origin", base)
    name = a.task if a.task.startswith(today) else f"{today}-{a.task}"
    tid = f"{today}-{provider}-{a.task.removeprefix(today + '-')}"
    if a.here:
        # Adopt the worktree we are standing in, normally the Claude desktop app's
        # <repo>/.claude/worktrees/<name>: no second worktree, no new branch, only the task file
        # and handoff that let other sessions see what this one owns (SESSIONS.md rules 2 and 3).
        if not linked:
            sys.exit("session: --here adopts the session worktree you are standing in, and the primary "
                     "checkout is not one; run `session start <task>` without --here to cut a sibling")
        t = my_task(top, f"origin/{base}")
        if t:
            sys.exit(f"session: this worktree already has a task file: {t.relative_to(top)}")
        wt = top
        branch = git(top, "branch", "--show-current")
        if not branch:
            sys.exit("session: --here needs a branch checked out (this worktree is detached)")
        base_commit = git(top, "rev-parse", "--short", git(top, "merge-base", f"origin/{base}", "HEAD"))
        disk_guard(primary, top, None, adopt=True)
    else:
        branch = f"agent/{provider}/{name}"
        wt = primary.parent / f"{primary.name}-wt-{name}"
        if wt.exists():
            sys.exit(f"session: {wt} already exists; pick another task name or `cd` there")
        base_commit = git(primary, "rev-parse", "--short", f"origin/{base}")
        disk_guard(primary, wt.parent, f"origin/{base}", adopt=False)
        git(primary, "worktree", "add", "-q", "-b", branch, str(wt), f"origin/{base}")
    activate_prepush(primary)
    rel = os.path.relpath(wt, primary)
    (wt / ".agents" / "tasks").mkdir(parents=True, exist_ok=True)
    (wt / ".agents" / "handoffs").mkdir(parents=True, exist_ok=True)
    task = {"id": tid, "provider": provider, "status": "active", "branch": branch,
            "worktree": rel, "base_commit": base_commit, "objective": a.objective or "",
            "owned_paths": a.own, "started": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
            "handoff": f".agents/handoffs/{tid}.md"}
    (wt / ".agents" / "tasks" / f"{tid}.json").write_text(json.dumps(task, indent=2) + "\n")
    tmpl = wt / ".agents" / "HANDOFF.template.md"
    body = tmpl.read_text() if tmpl.exists() else "# Agent handoff: <task>\n"
    fill = {"# Agent handoff: <task>": f"# Agent handoff: {a.task}",
            "- Status: planned | active | review-ready | blocked | complete": "- Status: active",
            "- Provider/agent:": f"- Provider/agent: {provider}",
            "- Objective:": f"- Objective: {a.objective or ''}",
            "- Worktree and branch:": f"- Worktree and branch: `{rel}`, `{branch}`",
            "- Base and head commits:": f"- Base and head commits: base `{base_commit}`; head recorded at merge.",
            "- Owned paths:": "- Owned paths: " + ", ".join(f"`{p}`" for p in a.own)}
    for k, v in fill.items():
        body = body.replace(k, v, 1)
    (wt / ".agents" / "handoffs" / f"{tid}.md").write_text(body)
    print(f"worktree: {wt}\nbranch:   {branch}\ntask:     {tid}\n")
    if a.here:
        print(f"Adopted this worktree. Commit here (specific files), then run:\n  python3 .agents/bin/session land")
    else:
        print(f"Work only under {wt}. Commit there (specific files), then run:\n  python3 .agents/bin/session land")
    print(f"Repos whose pre-commit checks ownership want: export AGENT_NAME={provider}")
    others = [s for s in sessions(primary) if s["path"] != str(wt)]
    if others:
        print(f"\n{len(others)} other live session(s) on this repo; run `python3 .agents/bin/session status` to see them.")


def name_list(cwd, *a, check=True, env=None):
    """`git diff --name-only` read with -z: unstripped and unquoted. Without -z git prints a path with
    a non-ASCII byte as a quoted escape (core.quotePath, on by default), which matches no ask path
    and, passed back as a pathspec, no file."""
    return [x for x in run(["git", "diff", "--name-only", "-z", *a], cwd, check, env).stdout.split("\0") if x]


def changed_paths(wt, base):
    """Paths a worktree changes: committed since the base plus uncommitted. Both are read with -z,
    unstripped and unquoted: `git()` strips its output, which ate the leading space of the first
    porcelain line (` M path`) and so the path's first character (an engagement repo, 2026-09-25), and without
    -z git quotes a path with a space or a non-ASCII byte. A rename gives both its old and new path,
    because another session touching either one is an overlap. wt is usually another session's worktree:
    both reads run READ_ONLY, so the status never takes its index lock (kit 20)."""
    committed = name_list(wt, "--no-renames", f"origin/{base}...HEAD", check=False, env=READ_ONLY)
    fields = run(["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"], wt, check=False,
                 env=READ_ONLY).stdout.split("\0")
    dirty = []
    while fields:
        e = fields.pop(0)
        if len(e) > 3:
            dirty.append(e[3:])
            if {"R", "C"} & set(e[:2]) and fields:
                dirty.append(fields.pop(0))
    return sorted(set(committed + dirty)), dirty


def sessions(primary):
    """Every live session worktree of the repository, read without taking any of their locks (kit 20)."""
    base = default_branch(primary)
    out, cur = [], {}
    for line in git(primary, "worktree", "list", "--porcelain", env=READ_ONLY).splitlines() + [""]:
        if not line:
            if cur:
                out.append(cur)
            cur = {}
            continue
        k, _, v = line.partition(" ")
        cur[k] = v or True
    res = []
    for w in out:
        p = Path(w["worktree"])
        if p.resolve() == primary.resolve() or w.get("prunable") or not p.exists():
            continue
        br = str(w.get("branch", "")).removeprefix("refs/heads/") or "(detached)"
        changed, dirty = changed_paths(p, base)
        counts = git(p, "rev-list", "--left-right", "--count", f"origin/{base}...HEAD", check=False, env=READ_ONLY).split()
        t = my_task(p, f"origin/{base}")
        task = json.loads(t.read_text()) if t and t.exists() else {}
        res.append({"path": str(p), "branch": br, "task": task.get("id", ""), "status": task.get("status", ""),
                    "objective": task.get("objective", ""), "owned_paths": task.get("owned_paths", []),
                    "changed": changed, "uncommitted": len(dirty),
                    "behind": int(counts[0]) if counts else 0, "ahead": int(counts[1]) if len(counts) > 1 else 0})
    return res


def overlaps(ss):
    found = []
    for i, l in enumerate(ss):
        for r in ss[i + 1:]:
            ignore = lambda x: x.startswith(".agents/tasks/") or x.startswith(".agents/handoffs/")
            files = sorted(set(x for x in l["changed"] if not ignore(x)) & set(x for x in r["changed"] if not ignore(x)))
            owned = [(lp, rp) for lp in l["owned_paths"] for rp in r["owned_paths"]
                     if lp == rp or lp.startswith(rp.rstrip("/") + "/") or rp.startswith(lp.rstrip("/") + "/")]
            if files or owned:
                found.append({"left": l["branch"], "right": r["branch"], "files": files, "owned": owned})
    return found


def cmd_status(a):
    _, primary, _ = here(a.here)
    base = default_branch(primary)
    run(["git", "fetch", "-q", "origin", base], primary, check=False)
    ss = sessions(primary)
    ov = overlaps(ss)
    EVENT["attrs"].update(sessions=len(ss), overlaps=len(ov))
    pbranch = git(primary, "branch", "--show-current", check=False) or "(detached)"
    pdirty = len(git(primary, "status", "--porcelain", check=False, env=READ_ONLY).splitlines())
    pbehind = primary_behind(primary, base)
    if a.json:
        print(json.dumps({"primary": str(primary), "primary_branch": pbranch, "primary_dirty": pdirty,
                          "primary_behind": pbehind, "sessions": ss, "overlaps": ov}, indent=2))
        return 1 if ov else 0
    print(f"primary: {primary}  on {pbranch}, {pdirty} uncommitted path(s)" +
          ("" if pbranch == base else f"  WARNING: primary should be on {base}"))
    print(f"primary: {pbehind} behind origin/{base}" +
          ("" if pbehind == 0 else "  (run `session finish` for a landed session, or wait for the hub's primary-ff sweep)"))
    if not ss:
        print("no live sessions")
    for s in ss:
        print(f"\n- {s['branch']}  ({s['task'] or 'no task file'})\n  {s['path']}")
        if s["objective"]:
            print(f"  objective: {s['objective']}")
        print(f"  {len(s['changed'])} changed file(s), {s['uncommitted']} uncommitted; {s['ahead']} ahead, {s['behind']} behind {base}")
    for o in ov:
        print(f"\nOVERLAP {o['left']} and {o['right']}: files {o['files'][:10]} owned {o['owned'][:5]}")
    return 1 if ov else 0


def ask_hits(changed, pol):
    pats = pol.get("ask_paths", [])
    return [x for x in changed for p in pats if fnmatch.fnmatch(x, p) or x == p.rstrip("/") or x.startswith(p.rstrip("/") + "/")]


def requires_pr(top, base):
    """Why the base branch must be reached through a PR, or "" when a direct push is allowed.

    A ruleset rule of type pull_request or required_status_checks, or classic branch protection
    that requires reviews or status checks. When GitHub cannot be asked, returns "" and the
    push itself is the test: a rejected protected-branch push falls back to a PR."""
    R = gh_repo(top)
    if not R:
        return ""
    r = run(["gh", "api", f"repos/{R[1]}/rules/branches/{base}"], top, check=False)
    if r.returncode == 0:
        try:
            types = {x.get("type") for x in json.loads(r.stdout or "[]")}
        except ValueError:
            types = set()
        hit = sorted(types & {"pull_request", "required_status_checks"})
        if hit:
            return f"a ruleset on {base} requires {' and '.join(hit)}"
    p = run(["gh", "api", f"repos/{R[1]}/branches/{base}/protection"], top, check=False)
    if p.returncode == 0:
        try:
            prot = json.loads(p.stdout or "{}")
        except ValueError:
            prot = {}
        if prot.get("required_pull_request_reviews") or prot.get("required_status_checks"):
            return f"branch protection on {base} requires reviews or status checks"
    return ""


def land_message(top, base, title, branch, since=None):
    """Squash message for a local landing: the session's subject, each commit's subject, and the
    commits' trailers (Co-Authored-By and the like) carried over once each."""
    since = since or f"origin/{base}"
    subjects = [x for x in git(top, "log", "--reverse", "--format=%s", f"{since}..HEAD").splitlines()
                if not x.startswith("session: close")]
    subject = title or (subjects[0] if subjects else f"{branch}: land")
    trailers = []
    for l in git(top, "log", "--reverse", "--format=%(trailers:only,unfold)", f"{since}..HEAD").splitlines():
        if l.strip() and l not in trailers:
            trailers.append(l)
    body = "\n".join(f"- {x}" for x in subjects) if len(subjects) > 1 else ""
    note = f"Landed locally by session land from {branch} (WS-DDR-143 amendment 2026-09-24)."
    return "\n\n".join(x for x in (subject, body, note, "\n".join(trailers)) if x)


def foreign_paths(top, squash, parent, own_base, head="HEAD"):
    """Paths the squash changes against the commit it lands on that none of the branch's own commits
    (own_base..head) touched. A correct squash has none: its tree is the branch rebased onto parent.
    Anything listed would be a silent revert of another session's landing (kit 19)."""
    landing = set(name_list(top, "--no-renames", parent, squash))
    own = set(x for x in run(["git", "log", "--no-renames", "-m", "--name-only", "-z", "--format=", f"{own_base}..{head}"],
                             top, check=False).stdout.replace("\n", "\0").split("\0") if x)
    return sorted(landing - own)


# KF-11, the knowledge farm's backpressure rule (kit 23): any content change over 25 files, counted per session
# and per day, lands only as a reviewed diff. On 2026-10-02 agents rewrote about 1,450 private files in place
# across many repos and landed them the same day, unread. The rule is measured on totals, so splitting the work
# into small lands does not dodge it. Advisory for now: `land` prints the advisory, writes a per-file diff
# summary into the session's handoff (which becomes the PR description on the PR route), and tells Witness.
# SESSION_KF11_ENFORCE=1, or "kf11": {"enforce": true} in .agents/repository-policy.json, turns it into a
# refusal of every route but `--no-merge` (a PR left open for a human). The rule text, under the Workspaces root:
KF11_RULE = "Core/products/_intake/2026-10-03-knowledge-farm-projection/rules/knowledge-farm-rules.md"
KF11_THRESHOLD = 25
# What is not content: the kit's own session records, lockfiles and generated outputs. Generated outputs are the
# repository's generated_patterns and kf11.exclude (repository-policy.json), files marked linguist-generated in
# .gitattributes, and the defaults below. Everything else (prose, code, data, images, a deletion) is content.
KF11_NOT_CONTENT_DIRS = (".agents/",)
KF11_LOCKFILES = {"package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb", "bun.lock",
                  "poetry.lock", "Pipfile.lock", "uv.lock", "pdm.lock", "Cargo.lock", "Gemfile.lock", "composer.lock",
                  "go.sum", "flake.lock", "mix.lock", "Podfile.lock", "packages.lock.json"}
KF11_GENERATED = ["**/node_modules/**", "**/__pycache__/**", "**/.venv/**", "**/dist/**", "**/generated/**",
                  "*.pyc", "*.min.js", "*.min.css", "*.js.map", "*.css.map", ".intent/observability/**"]
KF11_START, KF11_END = "<!-- kf11:start -->", "<!-- kf11:end -->"
KF11_ROWS = 300  # rows of the per-file table in the handoff; the whole diff is one git command away
LANDED_FROM = re.compile(r"Landed locally by session land from (\S+) \(")


def _glob(path, pattern):
    """The audit's matcher: fnmatch, with a leading **/ also matching at the top level."""
    return fnmatch.fnmatch(path, pattern) or fnmatch.fnmatch(path, pattern.removeprefix("**/"))


def kf11_content(top, paths):
    """The paths that are content (see KF11_NOT_CONTENT_DIRS above). An unreadable policy or a failed attribute
    read only means fewer exclusions, so the count errs high, never low."""
    pol = policy(top)
    kf = pol.get("kf11") if isinstance(pol.get("kf11"), dict) else {}
    pats = [p for p in KF11_GENERATED + list(pol.get("generated_patterns", [])) + list(kf.get("exclude", []))
            if isinstance(p, str)]
    out = [p for p in paths if not p.startswith(KF11_NOT_CONTENT_DIRS) and p.rsplit("/", 1)[-1] not in KF11_LOCKFILES
           and not any(_glob(p, x) for x in pats)]
    if out:
        r = subprocess.run(["git", "check-attr", "-z", "--stdin", "linguist-generated"], cwd=top, capture_output=True,
                           input="\0".join(out).encode() + b"\0", env={**os.environ, **READ_ONLY})
        if r.returncode == 0:
            f = r.stdout.split(b"\0")
            gen = {f[i].decode(errors="replace") for i in range(0, len(f) - 2, 3) if f[i + 2] in (b"set", b"true")}
            out = [p for p in out if p not in gen]
    return out


def _branch_agent(branch):
    """The agent a branch name carries: agent/<provider>/<task>, or the desktop app's <provider>/<name>."""
    parts = (branch or "").split("/")
    return (parts[1] if parts[0] == "agent" and len(parts) > 2 else parts[0]) or "unknown"


def kf11_agent(task, branch):
    """Who is landing: AGENT_NAME, else the task's provider, else the branch's (agent/<provider>/..., or the
    desktop app's <provider>/<name>)."""
    if os.environ.get("AGENT_NAME", "").strip():
        return os.environ["AGENT_NAME"].strip()
    return task.get("provider") or _branch_agent(branch)


def kf11_ledger(primary):
    """This clone's record of landings, in the common git dir every worktree shares (never committed)."""
    return Path(git(primary, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "session-kf11.jsonl"


def kf11_earlier(top, primary, pin, branch, agent, day_start):
    """(this session's earlier landed content files, today's landed content files by this agent), as sets.
    Read from origin/<base> (a local landing's squash message names its branch, so landings made on any machine
    count) and from this clone's ledger (which also holds landings that went through a PR). Fail-open: a read
    that breaks leaves what was read so far."""
    mine, today = set(), set()
    try:
        log = run(["git", "log", "-F", "--grep=Landed locally by session land from ", "--format=%H%x1f%cI%x1f%B%x1e",
                   pin], top, check=False, env=READ_ONLY).stdout
        for rec in log.split("\x1e"):
            parts = rec.strip("\n").split("\x1f")
            m = LANDED_FROM.search(parts[2]) if len(parts) == 3 else None
            if not m:
                continue
            ours = m.group(1) == branch
            todays = dt.datetime.fromisoformat(parts[1]) >= day_start and _branch_agent(m.group(1)) == agent
            if not (ours or todays):
                continue
            names_ = [x for x in run(["git", "diff-tree", "--no-commit-id", "-r", "-z", "--name-only", "--no-renames",
                                      parts[0].strip()], top, check=False, env=READ_ONLY).stdout.split("\0") if x]
            files = set(kf11_content(top, names_))
            if ours:
                mine |= files
            if todays:
                today |= files
        led = kf11_ledger(primary)
        for line in led.read_text().splitlines() if led.is_file() else []:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            files = {x for x in e.get("files", []) if isinstance(x, str)}
            if e.get("branch") == branch:
                mine |= files
            if e.get("agent") == agent and e.get("day") == day_start.date().isoformat():
                today |= files
    except Exception:
        pass
    return mine, today


def kf11_record(primary, agent, branch, files):
    """One line per landing in this clone's ledger. Fail-open."""
    try:
        with open(kf11_ledger(primary), "a") as f:
            f.write(json.dumps({"day": dt.date.today().isoformat(), "agent": agent, "branch": branch,
                                "at": dt.datetime.now().astimezone().isoformat(timespec="seconds"), "files": files}) + "\n")
    except Exception:
        pass


def kf11_summary(top, pin, content, session_n, day_n, agent):
    """The per-file diff summary a reviewer reads: the section land writes into the handoff."""
    rows, status = {}, {}
    for line in run(["git", "diff", "--numstat", "-z", "--no-renames", pin, "HEAD"], top, check=False).stdout.split("\0"):
        bits = line.split("\t")
        if len(bits) == 3:
            rows[bits[2]] = (bits[0], bits[1])
    raw = run(["git", "diff", "--name-status", "-z", "--no-renames", pin, "HEAD"], top, check=False).stdout.split("\0")
    for i in range(0, len(raw) - 1, 2):
        status[raw[i + 1]] = raw[i]
    head = git(top, "rev-parse", "--short=10", "HEAD", check=False)
    lines = [KF11_START, "## KF-11 review: a content change over the threshold", "",
             f"Rule KF-11 (`{KF11_RULE}`, under the Workspaces root): any content change over {KF11_THRESHOLD} files, "
             "counted per session and per day, lands only as a reviewed diff.", "",
             f"- This land: {len(content)} content file(s). This session in all: {session_n}. "
             f"Today, by agent `{agent}` in this repository: {day_n}. Threshold: {KF11_THRESHOLD}.",
             f"- Base `{pin[:10]}`, head `{head}` (the head before the squash). The whole diff: `git diff {pin[:10]} {head}`.",
             "- Reviewer: read the table and the diff, then say yes or no.", "",
             "| File | Change | Added | Removed |", "|---|---|---|---|"]
    for p in content[:KF11_ROWS]:
        add, rem = rows.get(p, ("?", "?"))
        lines.append(f"| `{p}` | {status.get(p, '?')} | {add} | {rem} |")
    if len(content) > KF11_ROWS:
        lines.append(f"| and {len(content) - KF11_ROWS} more | | | |")
    lines.append(KF11_END)
    return "\n".join(lines) + "\n"


def kf11_check(a, top, primary, pin, task, branch):
    """Measure this land against KF-11. Over the threshold: print the advisory, write the review section into
    the handoff and commit it (a .agents/ path, so it adds nothing to the count), and under enforcement refuse
    every route but --no-merge. Returns (agent, content files of this land)."""
    content = kf11_content(top, name_list(top, "--no-renames", pin, "HEAD"))
    agent = kf11_agent(task, branch)
    day_start = dt.datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    mine, today = kf11_earlier(top, primary, pin, branch, agent, day_start)
    session_n, day_n = len(mine | set(content)), len(today | set(content))
    EVENT["attrs"].update(kf11_files=len(content), kf11_session_files=session_n, kf11_day_files=day_n,
                          kf11_threshold=KF11_THRESHOLD)
    if session_n <= KF11_THRESHOLD and day_n <= KF11_THRESHOLD:
        EVENT["attrs"]["kf11"] = "under"
        return agent, content
    pol = policy(top)
    enforce = (os.environ.get("SESSION_KF11_ENFORCE", "").strip() == "1"
               or (isinstance(pol.get("kf11"), dict) and pol["kf11"].get("enforce") is True))
    over = [x for x, n in (("this session", session_n), (f"today's lands by {agent}", day_n)) if n > KF11_THRESHOLD]
    rel = task.get("handoff") or f".agents/handoffs/{branch.replace('/', '-')}.md"
    try:
        h = top / rel
        old = h.read_text() if h.is_file() else f"# Agent handoff: {branch}\n"
        cut = re.compile(re.escape(KF11_START) + r".*?" + re.escape(KF11_END) + r"\n?", re.S)
        h.parent.mkdir(parents=True, exist_ok=True)
        h.write_text(cut.sub("", old).rstrip("\n") + "\n\n" + kf11_summary(top, pin, content, session_n, day_n, agent))
        git(top, "add", "--", rel)
        if git(top, "status", "--porcelain", "--untracked-files=no", env=READ_ONLY):
            if pushed(top):
                commit(top, task.get("provider", "claude"), "-q", "-m", "session: KF-11 review summary")
            else:
                commit(top, task.get("provider", "claude"), "-q", "--amend", "--no-edit")
        where = f"The per-file review summary is in {rel}"
    except SystemExit:
        raise
    except Exception as e:  # the advisory never fails a land it could not document
        where = f"The review summary could not be written ({type(e).__name__})"
    print(f"\nKF-11 ADVISORY: content changes over {KF11_THRESHOLD} files ({', '.join(over)}): this land {len(content)}, "
          f"this session {session_n}, today by {agent} {day_n}.\n"
          f"KF-11 says a change this size lands only as a reviewed diff (rule: {KF11_RULE}, under the Workspaces root).\n"
          f"{where}. To land it for review: `python3 .agents/bin/session land --no-merge` opens a PR and leaves it "
          "for a human.")
    if enforce and not a.no_merge:
        EVENT["attrs"].update(kf11="refused", reason="kf11")
        sys.exit("session: refused under KF-11 enforcement (SESSION_KF11_ENFORCE=1, or kf11.enforce in "
                 ".agents/repository-policy.json); nothing was pushed. Run `python3 .agents/bin/session land --no-merge` "
                 "so a human reviews the diff")
    EVENT["attrs"]["kf11"] = "reviewed_pr" if a.no_merge else "advisory"
    if not a.no_merge:
        print("KF-11 is advisory today, so this land goes on. SESSION_KF11_ENFORCE=1 turns it into a refusal.\n")
    return agent, content


def cmd_land(a):
    top, primary, linked = here(a.here)
    if not linked:
        sys.exit("session: land runs inside a session worktree, not the primary checkout")
    base = default_branch(primary)
    if git(top, "status", "--porcelain", "--untracked-files=no", env=READ_ONLY):
        sys.exit("session: commit or set aside your tracked changes first (never stash another session's work)")
    if os.path.exists(os.path.join(git(top, "rev-parse", "--git-dir"), "rebase-merge")):
        sys.exit("session: a rebase is in progress; resolve by meaning, `git add`, `git rebase --continue`, then land again")
    put_back(top)  # what a land stopped by a conflict kept aside, now that its rebase has finished
    git(top, "fetch", "-q", "origin", base)
    activate_prepush(top)
    t = my_task(top, f"origin/{base}")
    if t:
        task = json.loads(t.read_text())
        if task.get("status") != "complete":
            task["status"] = "complete"
            task["landed"] = dt.datetime.now().astimezone().isoformat(timespec="seconds")
            t.write_text(json.dumps(task, indent=2) + "\n")
            h = top / task.get("handoff", "")
            if h.is_file():
                h.write_text(re.sub(r"^- Status: .*$", "- Status: complete", h.read_text(), count=1, flags=re.M))
                git(top, "add", str(h.relative_to(top)))
            git(top, "add", str(t.relative_to(top)))
            # Fold the close into the session's own last commit when that commit has not left the
            # machine: a separate `session: close` commit cost its own CI cycle (about 20 percent of
            # session CI, measured 2026-09-24). A commit already pushed is never amended.
            ahead = git(top, "rev-list", "--count", f"origin/{base}..HEAD") != "0"
            if ahead and not pushed(top):
                commit(top, task.get("provider", "claude"), "-q", "--amend", "--no-edit")
            else:
                commit(top, task.get("provider", "claude"), "-q", "-m", f"session: close {task['id']}")
    branch = git(top, "branch", "--show-current")
    if git(top, "rev-list", "--count", f"origin/{base}..HEAD") == "0":
        sys.exit("session: nothing to land")
    pin = rebase_on_base(top, base, branch)
    if not pin:
        return 3
    if git(top, "rev-list", "--count", f"{pin}..HEAD") == "0":
        print(f"nothing new to land: everything on this branch is already on origin/{base}")
        return 0
    # KF-11 (kit 23): measured on the rebased tree, before the gates, so its handoff commit is judged with the rest
    kf_agent, kf_content = kf11_check(a, top, primary, pin, json.loads(t.read_text()) if t and t.is_file() else {}, branch)
    gate = pre_land_commands(top)  # read first: a broken declaration stops the land with its own reason
    audit = top / ".agents" / "bin" / "agent_repo_audit.py"
    if audit.exists():
        ar = run([sys.executable, str(audit), "--check", "--against", pin], top, check=False)
        print(ar.stdout.strip())
        if ar.returncode:
            sys.exit("session: audit found errors; fix them and land again")
    run_pre_land(top, gate)  # the tree that would land: this branch rebased onto origin/<base> (kit 18)
    if not portability_check(top):
        sys.exit("session: portability check failed (the check CI used to run on every push); fix it and land again")
    changed = name_list(top, "--no-renames", f"{pin}...HEAD")
    EVENT["attrs"]["files"] = len(changed)
    # Local landing is the default (WS-DDR-143 amendment 2026-09-24): the checks already ran here,
    # so a PR would only buy a second, billed run of them. A PR is used for ask paths (a human
    # decides), for a base branch that requires one, or when asked for with --pr or --no-merge.
    hits = ask_hits(changed, policy(top))
    why_pr = ("--pr" if a.pr else "--no-merge" if a.no_merge else
              f"touches ask paths {sorted(set(hits))[:8]}" if hits and not a.local else
              "" if a.local else requires_pr(top, base))
    if not why_pr:
        for attempt in range(3):
            head = git(top, "rev-parse", "HEAD")
            # the parent is the commit this branch was rebased onto (pin), never the shared origin/<base>
            # ref re-read here: a sibling worktree's push moves that ref during the gate (kit 19)
            squash = git(top, "commit-tree", f"{head}^{{tree}}", "-p", pin, "-m", land_message(top, base, a.title, branch, since=pin))
            foreign = foreign_paths(top, squash, pin, pin, head)
            if foreign:
                EVENT["attrs"]["reason"] = "foreign_paths"
                sys.exit(f"session: refused: the squash would change {len(foreign)} path(s) this branch never touched "
                         f"({names(foreign)}); that is another session's landing being reverted. Nothing was pushed. "
                         "Run `python3 .agents/bin/session land` again, and report this to the kit's owner")
            p = run(["git", "push", "-q", "origin", f"{squash}:refs/heads/{base}"], top, check=False)
            if p.returncode == 0:
                EVENT["attrs"]["route"] = "local"
                print(f"landed locally as {squash[:8]} on origin/{base} (no PR, no CI run)")
                kf11_record(primary, kf_agent, branch, kf_content)
                # the branch follows its squash (same tree): a later land replays only what is new
                follow(top, squash, head, base)
                ff_primary(primary, base)
                print("Next: python3 .agents/bin/session finish")
                return 0
            err = (p.stderr or p.stdout).strip()
            if re.search(r"protected branch|GH006|GH013|rule violations|required status check|pull request", err, re.I):
                why_pr = f"the push to {base} was refused: {' '.join(err.split())[:160]}"
                break
            if "fetch first" not in err and "non-fast-forward" not in err and "rejected" not in err:
                sys.exit(f"session: push to {base} failed:\n{err}")
            # someone landed in between: take their change and go again
            git(top, "fetch", "-q", "origin", base)
            pin = rebase_on_base(top, base, branch)
            if not pin:
                return 3
            run_pre_land(top, pre_land_commands(top))  # a new tree: the other session's landing is in it
            if not portability_check(top):
                sys.exit("session: portability check failed after the rebase; fix it and land again")
        else:
            sys.exit(f"session: origin/{base} kept moving; run `python3 .agents/bin/session land` again")
    EVENT["attrs"]["route"] = "pr"
    print(f"Landing through a PR: {why_pr}")
    # prune first: a branch GitHub deleted on an earlier merge leaves a stale origin/<branch> that
    # makes --force-with-lease refuse the push
    run(["git", "fetch", "-q", "--prune", "origin"], top, check=False)
    head = git(top, "rev-parse", "HEAD")
    git(top, "push", "-q", "--force-with-lease", "-u", "origin", branch)
    # an open PR only: `gh pr view <branch>` also returns the branch's merged PR from an earlier land
    pr = run(["gh", "pr", "list", *gh_repo(top), "--head", branch, "--base", base, "--state", "open",
              "--json", "url", "-q", ".[0].url // empty"], top, check=False)
    if pr.returncode or not pr.stdout.strip():
        subjects = git(top, "log", "--reverse", "--format=%s", f"origin/{base}..HEAD").splitlines()
        title = a.title or next((x for x in subjects if not x.startswith("session: close")), branch)
        body = "Session branch landed under .agents/SESSIONS.md.\n\nChanged: " + ", ".join(f"`{c}`" for c in changed[:30])
        if t:
            h = top / json.loads(t.read_text()).get("handoff", "")
            if h.is_file():
                text = h.read_text()
                i = text.find(KF11_START)  # a KF-11 review section always reaches the PR description whole
                body = text[:6000] if i < 0 else (text[:min(i, 3000)].rstrip() + "\n\n" + text[i:])[:60000]
        pr = run(["gh", "pr", "create", *gh_repo(top), "--head", branch, "--base", base, "--title", title, "--body", body + FOOTER], top)
    url = pr.stdout.strip().splitlines()[-1]
    print(f"PR: {url}")
    kf11_record(primary, kf_agent, branch, kf_content)
    if hits or a.no_merge:
        print("Left open for a human" + (f": touches ask paths {sorted(set(hits))[:8]}" if hits else ""))
        return 0
    m = run(["gh", "pr", "merge", url, *gh_repo(top), "--squash", "--delete-branch", "--auto"], top, check=False)
    if m.returncode:
        m = run(["gh", "pr", "merge", url, *gh_repo(top), "--squash", "--delete-branch"], top, check=False)
    info = run(["gh", "pr", "view", url, *gh_repo(top), "--json", "state,autoMergeRequest,mergeCommit", "-q",
                "[.state, (.autoMergeRequest != null), (.mergeCommit.oid // \"\")] | @tsv"], top, check=False).stdout.strip().split("\t")
    state, armed, merged = (info + ["", "", ""])[:3]
    if state == "MERGED":
        print("PR merged.")
        ff_primary(primary, base)
        if not (merged and follow(top, merged, head, base)):
            print("branch still carries the merged commits (the squash is not this head's tree); "
                  "the next land from this worktree skips them")
        print("Next: python3 .agents/bin/session finish")
    elif armed == "true":
        print("Auto-merge armed: the PR squash-merges by itself when its checks pass.\n"
              f"Until then nothing moves the primary: it lags origin/{base} after the merge until\n"
              "`python3 .agents/bin/session finish` runs or the hub's primary-ff sweep passes (every 30 min).\n"
              "Then: python3 .agents/bin/session finish")
    else:
        print(f"PR state: {state or 'unknown'}, not merged" + (f"\n{m.stderr.strip()}" if m.returncode else ""))
    return 0


def cmd_finish(a):
    top, primary, linked = here(a.here)
    base = default_branch(primary)
    if linked:
        wt = top
    else:
        cands = [s for s in sessions(primary) if a.task and a.task in (s["branch"] + s["task"] + s["path"])]
        if len(cands) != 1:
            sys.exit("session: from the primary checkout, name the session with --task")
        wt = Path(cands[0]["path"])
    branch = git(wt, "branch", "--show-current")
    git(primary, "fetch", "-q", "--prune", "origin")
    st, pr_head = (run(["gh", "pr", "view", branch, *gh_repo(wt), "--json", "state,headRefOid", "-q",
                        "[.state, .headRefOid] | @tsv"], wt, check=False).stdout.strip().split("\t") + ["", ""])[:2]
    mine = name_list(wt, "--no-renames", f"origin/{base}...HEAD", check=False, env=READ_ONLY)
    contained = not mine or not name_list(wt, "HEAD", f"origin/{base}", "--", *mine, check=False, env=READ_ONLY)
    # a merged PR counts only when it merged this head: commits made after an earlier landing have not landed
    if not (st == "MERGED" and pr_head == git(wt, "rev-parse", "HEAD")) and not contained:
        if st == "MERGED":
            sys.exit(f"session: {branch} has commits after the head its merged PR carried; land them first")
        if st == "OPEN":
            sys.exit(f"session: the PR for {branch} is still open (checks running or awaiting a human); finish again once it merges")
        sys.exit(f"session: {branch} is not merged (PR state {st or 'none'}); land it first")
    left = put_back(wt)
    if left:
        sys.exit(f"session: land kept {names(left)} aside in {kept_dir(wt)} and could not put it back; removing the "
                 "worktree would delete that copy. Merge it by hand, delete the kept copy, then finish again")
    if git(wt, "status", "--porcelain", env=READ_ONLY):
        sys.exit(f"session: {wt} has uncommitted changes; they are not yours to discard")
    ff_primary(primary, base)
    if "/.claude/worktrees/" in str(wt):
        print(f"left {wt} in place: the desktop app owns that worktree")
        return 0
    os.chdir(primary)  # never remove the directory we are standing in
    git(primary, "worktree", "remove", str(wt))
    run(["git", "branch", "-D", branch], primary, check=False)
    print(f"removed {wt} and local branch {branch}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="session", description="Parallel sessions: see .agents/SESSIONS.md")
    sub = p.add_subparsers(dest="cmd", required=True)
    other = "act on the repository the shell is in even though this script belongs to another one (kit 17)"
    s = sub.add_parser("start"); s.add_argument("task"); s.add_argument("--own", action="append", default=[])
    s.add_argument("--provider"); s.add_argument("--objective")
    s.add_argument("--here", action="store_true", help="adopt the session worktree you are in (the desktop app's .claude/worktrees/<name>) instead of cutting a sibling; the repository it belongs to is the one meant, even if this script belongs to another")
    s = sub.add_parser("status"); s.add_argument("--json", action="store_true")
    s.add_argument("--here", action="store_true", help=other)
    s = sub.add_parser("land"); s.add_argument("--title")
    s.add_argument("--pr", action="store_true", help="land through a pull request even where local landing is allowed")
    s.add_argument("--no-merge", action="store_true", help="open the PR and leave it for a human")
    s.add_argument("--local", action="store_true", help="land locally even for ask paths (skips the ruleset lookup)")
    s.add_argument("--here", action="store_true", help=other)
    s = sub.add_parser("finish"); s.add_argument("--task")
    s.add_argument("--here", action="store_true", help=other)
    a = p.parse_args()
    started, code = time.monotonic(), "uncaught exception"
    EVENT["verb"] = a.cmd
    try:
        code = {"start": cmd_start, "status": cmd_status, "land": cmd_land, "finish": cmd_finish}[a.cmd](a) or 0
        return code
    except SystemExit as e:
        code = e.code
        raise
    finally:
        witness_report(a.cmd, code, started)


if __name__ == "__main__":
    sys.exit(main())
